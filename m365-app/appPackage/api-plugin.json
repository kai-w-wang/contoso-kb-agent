{
  "$schema": "https://aka.ms/json-schemas/copilot/plugin/v2.2/schema.json",
  "schema_version": "v2.2",
  "name_for_human": "Contoso Bank KB Search",
  "description_for_human": "Search the Contoso Bank knowledge base and provide feedback on answers.",
  "description_for_model": "This plugin searches the Contoso Bank knowledge base powered by Azure AI Search. Use it to find answers about account opening, credit cards, loans, digital banking, security, and other banking topics. It also accepts user feedback on answer quality. When a user wants to give feedback or rate an answer, use the submitFeedback function.",
  "namespace": "contosoKb",
  "functions": [
    {
      "name": "askQuestion",
      "description": "Ask a question to the Contoso Bank knowledge base and get an answer with citations.",
      "capabilities": {
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "Contoso Bank KB Answer",
            "subtitle": "From Contoso Bank Knowledge Base"
          },
          "static_template": {
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "type": "AdaptiveCard",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "${answer}",
                "wrap": true,
                "size": "Medium"
              },
              {
                "type": "TextBlock",
                "text": "💬 To give feedback, say: \"That was helpful\" or \"The answer was incomplete\"",
                "wrap": true,
                "size": "Small",
                "isSubtle": true,
                "spacing": "Large",
                "separator": true
              }
            ]
          }
        }
      }
    },
    {
      "name": "submitFeedback",
      "description": "Submit user feedback on a knowledge base answer. Use when a user says they want to rate an answer, give feedback, or says the answer was helpful or not helpful.",
      "capabilities": {
        "response_semantics": {
          "data_path": "$",
          "properties": {
            "title": "Feedback Submitted",
            "subtitle": "${message}"
          },
          "static_template": {
            "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
            "type": "AdaptiveCard",
            "version": "1.5",
            "body": [
              {
                "type": "TextBlock",
                "text": "✅ ${message}",
                "wrap": true,
                "size": "Medium",
                "color": "Good"
              },
              {
                "type": "TextBlock",
                "text": "Feedback ID: ${feedback_id}",
                "wrap": true,
                "size": "Small",
                "isSubtle": true
              }
            ]
          }
        }
      }
    }
  ],
  "runtimes": [
    {
      "type": "OpenApi",
      "auth": {
        "type": "None"
      },
      "spec": {
        "url": "openapi.json"
      },
      "run_for_functions": ["askQuestion", "submitFeedback"]
    }
  ]
}
